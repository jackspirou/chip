// Mutual recursion: even calls odd and odd calls even. even references odd
// before odd is defined; chip resolves the forward reference by reading ahead.
// even(n) returns 1 when n is even, 0 when odd.
func even(n int) int {
    if n == 0 {
        return 1
    }
    return odd(n - 1)
}

func odd(n int) int {
    if n == 0 {
        return 0
    }
    return even(n - 1)
}

func main() {
    print(even(10))
}
